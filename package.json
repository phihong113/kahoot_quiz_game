{
  "name": "kahoot-quiz-game",
  "version": "1.0.0",
  "description": "Kahoot-like real-time interactive quiz game for teachers and students",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "tunnel": "npx localtunnel --port 3000",
    "build-exe": "npx @yao-pkg/pkg server.js --targets node18-win-x64 --output QuizMaster_LIVE.exe"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ]
  },
  "dependencies": {
    "express": "^4.19.2",
    "localtunnel": "^2.0.2",
    "socket.io": "^4.7.5"
  }
}
